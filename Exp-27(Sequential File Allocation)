#include <stdio.h>

int main()
{
    int n, i, record;

    printf("Enter number of records: ");
    scanf("%d", &n);

    printf("\nRecords stored sequentially:\n");
    for(i = 1; i <= n; i++)
    {
        printf("Record %d -> Block %d\n", i, i - 1);
    }

    printf("\nEnter record number to access: ");
    scanf("%d", &record);

    if(record > n || record < 1)
    {
        printf("Invalid Record Number\n");
        return 0;
    }

    printf("\nReading records sequentially:\n");
    for(i = 1; i <= record; i++)
    {
        printf("Reading Record %d\n", i);
    }

    printf("\nRecord %d accessed successfully\n", record);

    return 0;
}
