#include <stdio.h>

int main()
{
    int n, i, indexBlock[20], block;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block addresses:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &indexBlock[i]);
    }

    printf("\nIndex Block:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d -> %d\n", i + 1, indexBlock[i]);
    }

    printf("\nEnter block number to access: ");
    scanf("%d", &block);

    if(block < 1 || block > n)
    {
        printf("Invalid Block Number\n");
    }
    else
    {
        printf("Block %d is stored at address %d\n",
               block, indexBlock[block - 1]);
    }

    return 0;
}
